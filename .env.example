# ==============================================================================
# NEXUS • SETU Emergency SOS & System Environment Configuration
# ==============================================================================

# Server Port & Mode
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Twilio Emergency SMS Configuration
# ------------------------------------------------------------------------------
# Get your Account SID and Auth Token from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your active Twilio phone number (in E.164 format, e.g. +1234567890)
TWILIO_PHONE_NUMBER=+12015550123

# The emergency response center / nodal officer contact number (E.164 format)
EMERGENCY_CONTACT_NUMBER=+919876543210
